{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": {
      "@howdah/board/*": ["../packages/board/src/lib/*"],
      "vitest": ["./node_modules/vitest"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "../packages/board/src/**/*.ts", "../packages/board/src/**/*.svelte"]
}
